# ===========================================
# NoteFlame Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

# --- Database ---
# PostgreSQL connection string
# For Render: auto-set via render.yaml
# For local dev: postgresql://user:password@localhost:5432/noteflame
# Free option: sign up at https://neon.tech for a free PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/noteflame

# --- Security ---
# Random secret for session cookies (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Secret used to derive encryption keys for drops
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=change-me-to-another-random-string

# --- Admin ---
# Password for the admin dashboard at /ghost-admin
# Set a strong password here - this is the only thing protecting your admin panel
ADMIN_PASSWORD=your-strong-admin-password-here

# --- Monetization ---
# Google AdSense client ID (optional)
# Sign up at https://adsense.google.com
# Format: ca-pub-XXXXXXXXXXXXXXXX
GOOGLE_ADSENSE_ID=

# --- App ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
