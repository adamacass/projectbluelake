# ===========================================
# GhostDrop Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

# --- Database ---
# PostgreSQL connection string
# For Render: auto-set via render.yaml
# For local dev: postgresql://user:password@localhost:5432/ghostdrop
# Free option: sign up at https://neon.tech for a free PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/ghostdrop

# --- Security ---
# Random secret for session cookies (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Secret used to derive encryption keys for drops
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=change-me-to-another-random-string

# --- Stripe (Payment Processing) ---
# Sign up at https://stripe.com
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Dashboard → Products
# Create two products: "GhostDrop Pro" ($8/mo) and "GhostDrop Business" ($24/mo)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# --- App ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
