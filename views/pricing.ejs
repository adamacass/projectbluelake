<section class="py-12">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-white">Simple, Transparent Pricing</h1>
      <p class="text-gray-400 mt-3 text-lg">Start free. Upgrade when you need more.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mt-12">
      <!-- Free -->
      <div class="gd-pricing-card">
        <h3 class="text-xl font-semibold text-white">Free</h3>
        <div class="mt-4">
          <span class="text-4xl font-bold text-white">$0</span>
          <span class="text-gray-400">/month</span>
        </div>
        <ul class="gd-pricing-features mt-6">
          <li>5 drops per day</li>
          <li>10KB content per drop</li>
          <li>24-hour max expiry</li>
          <li>1 view per drop (burn after reading)</li>
          <li>AES-256-GCM encryption</li>
        </ul>
        <a href="/new" class="gd-btn-secondary w-full py-3 mt-8 inline-block text-center">Get Started</a>
      </div>

      <!-- Pro -->
      <div class="gd-pricing-card gd-pricing-featured">
        <div class="gd-pricing-popular">Most Popular</div>
        <h3 class="text-xl font-semibold text-white">Pro</h3>
        <div class="mt-4">
          <span class="text-4xl font-bold text-white">$8</span>
          <span class="text-gray-400">/month</span>
        </div>
        <ul class="gd-pricing-features mt-6">
          <li>100 drops per day</li>
          <li>500KB content per drop</li>
          <li>30-day max expiry</li>
          <li>Up to 100 views per drop</li>
          <li>Password protection</li>
          <li>Burn notifications</li>
          <li>REST API access</li>
          <li>Dashboard &amp; analytics</li>
        </ul>
        <% if (user && stripePublishableKey) { %>
          <form action="/api/create-checkout" method="POST">
            <input type="hidden" name="plan" value="pro">
            <button type="submit" class="gd-btn-primary w-full py-3 mt-8">Upgrade to Pro</button>
          </form>
        <% } else if (user) { %>
          <span class="gd-btn-primary w-full py-3 mt-8 inline-block text-center opacity-60">Stripe not configured</span>
        <% } else { %>
          <a href="/register" class="gd-btn-primary w-full py-3 mt-8 inline-block text-center">Sign Up for Pro</a>
        <% } %>
      </div>

      <!-- Business -->
      <div class="gd-pricing-card">
        <h3 class="text-xl font-semibold text-white">Business</h3>
        <div class="mt-4">
          <span class="text-4xl font-bold text-white">$24</span>
          <span class="text-gray-400">/month</span>
        </div>
        <ul class="gd-pricing-features mt-6">
          <li>10,000 drops per day</li>
          <li>5MB content per drop</li>
          <li>90-day max expiry</li>
          <li>Up to 10,000 views per drop</li>
          <li>Everything in Pro</li>
          <li>Priority support</li>
          <li>Team features (coming soon)</li>
        </ul>
        <% if (user && stripePublishableKey) { %>
          <form action="/api/create-checkout" method="POST">
            <input type="hidden" name="plan" value="business">
            <button type="submit" class="gd-btn-secondary w-full py-3 mt-8">Upgrade to Business</button>
          </form>
        <% } else if (user) { %>
          <span class="gd-btn-secondary w-full py-3 mt-8 inline-block text-center opacity-60">Stripe not configured</span>
        <% } else { %>
          <a href="/register" class="gd-btn-secondary w-full py-3 mt-8 inline-block text-center">Sign Up</a>
        <% } %>
      </div>
    </div>
  </div>
</section>
