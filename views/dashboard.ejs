<div class="dash-wrap">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem">
    <div>
      <h1 style="font-size:1.5rem;font-weight:800">Dashboard</h1>
      <p style="color:var(--dim);font-size:.85rem"><%= user.email %></p>
    </div>
    <a href="/new" class="btn btn-lime btn-sm">New drop</a>
  </div>

  <div class="dash-stats">
    <div class="dash-stat"><span class="dash-stat-num"><%= stats.active_drops %></span><span class="dash-stat-label">Active</span></div>
    <div class="dash-stat"><span class="dash-stat-num"><%= stats.destroyed_drops %></span><span class="dash-stat-label">Destroyed</span></div>
    <div class="dash-stat"><span class="dash-stat-num"><%= stats.total_views %></span><span class="dash-stat-label">Views</span></div>
  </div>

  <% if (notifications.length > 0) { %>
  <div class="dash-section">
    <h2>Notifications <form method="POST" action="/dashboard/notifications/read-all" style="display:inline"><button type="submit" class="btn-ghost" style="font-size:.65rem;color:var(--lime);font-family:var(--mono);text-transform:uppercase">[clear all]</button></form></h2>
    <% notifications.forEach(n => { %>
      <div class="notif"><span><%= n.message %></span><span style="font-size:.7rem;color:var(--muted);white-space:nowrap;margin-left:1rem"><%= new Date(n.created_at).toLocaleString() %></span></div>
    <% }) %>
  </div>
  <% } %>

  <div class="dash-section">
    <h2>Your drops</h2>
    <% if (drops.length === 0) { %>
      <p style="color:var(--muted);font-size:.85rem;padding:2rem 0">No drops yet. <a href="/new">Create one.</a></p>
    <% } else { %>
      <div style="overflow-x:auto">
        <table class="tbl">
          <thead><tr><th>Codename</th><th>Status</th><th>Views</th><th>Expires</th><th>Created</th><th></th></tr></thead>
          <tbody>
          <% drops.forEach(d => { %>
            <tr>
              <td style="color:var(--text);font-family:var(--mono);font-size:.78rem"><%= d.codename || d.label || '(unnamed)' %><% if (d.has_password) { %> <span style="color:var(--orange)" title="Password protected">*</span><% } %></td>
              <td><% if (d.is_destroyed) { %><span class="s-dead">DEAD</span><% } else if (d.expires_at && new Date(d.expires_at) < new Date()) { %><span class="s-dead">EXPIRED</span><% } else { %><span class="s-active">LIVE</span><% } %></td>
              <td style="font-family:var(--mono);font-size:.78rem"><%= d.current_views %>/<%= d.max_views %></td>
              <td style="font-size:.78rem"><% if (d.expires_at) { %><%= new Date(d.expires_at).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %><% } else { %>-<% } %></td>
              <td style="font-size:.78rem"><%= new Date(d.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></td>
              <td><% if (!d.is_destroyed) { %><form method="POST" action="/dashboard/drops/<%= d.id %>/destroy" onsubmit="return confirm('Destroy this drop?')"><button type="submit" class="btn-ghost" style="color:var(--red);font-size:.7rem;font-family:var(--mono)">KILL</button></form><% } %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
