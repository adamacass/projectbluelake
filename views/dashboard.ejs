<section class="py-12">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center">
      <div>
        <h1 class="text-3xl font-bold text-white">Dashboard</h1>
        <p class="text-gray-400 mt-1">
          Plan: <span class="gd-plan-badge gd-plan-<%= user.plan %>"><%= user.plan.charAt(0).toUpperCase() + user.plan.slice(1) %></span>
          <% if (user.plan === 'free') { %>
            &mdash; <a href="/pricing" class="text-purple-400 hover:text-purple-300">Upgrade</a>
          <% } %>
        </p>
      </div>
      <a href="/new" class="gd-btn-primary px-6 py-2 mt-4 sm:mt-0">New Drop</a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 mt-8">
      <div class="gd-stat-card">
        <span class="text-2xl font-bold text-white"><%= stats.active_drops %></span>
        <span class="text-sm text-gray-400">Active Drops</span>
      </div>
      <div class="gd-stat-card">
        <span class="text-2xl font-bold text-white"><%= stats.destroyed_drops %></span>
        <span class="text-sm text-gray-400">Destroyed</span>
      </div>
      <div class="gd-stat-card">
        <span class="text-2xl font-bold text-white"><%= stats.total_views %></span>
        <span class="text-sm text-gray-400">Total Views</span>
      </div>
    </div>

    <!-- Notifications -->
    <% if (notifications.length > 0) { %>
      <div class="mt-8">
        <div class="flex justify-between items-center">
          <h2 class="text-xl font-semibold text-white">Notifications</h2>
          <form method="POST" action="/dashboard/notifications/read-all">
            <button type="submit" class="text-sm text-purple-400 hover:text-purple-300">Mark all read</button>
          </form>
        </div>
        <div class="mt-3 space-y-2">
          <% notifications.forEach(n => { %>
            <div class="gd-notification">
              <span class="text-gray-300"><%= n.message %></span>
              <div class="flex items-center space-x-3">
                <span class="text-xs text-gray-500"><%= new Date(n.created_at).toLocaleString() %></span>
                <form method="POST" action="/dashboard/notifications/<%= n.id %>/read" class="inline">
                  <button type="submit" class="text-xs text-gray-500 hover:text-gray-300">&times;</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Drops Table -->
    <div class="mt-8">
      <h2 class="text-xl font-semibold text-white">Your Drops</h2>
      <% if (drops.length === 0) { %>
        <div class="gd-empty mt-4">
          <p class="text-gray-400">No drops yet.</p>
          <a href="/new" class="text-purple-400 hover:text-purple-300">Create your first drop &rarr;</a>
        </div>
      <% } else { %>
        <div class="mt-4 overflow-x-auto">
          <table class="gd-table w-full">
            <thead>
              <tr>
                <th>Label</th>
                <th>Status</th>
                <th>Views</th>
                <th>Expires</th>
                <th>Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% drops.forEach(drop => { %>
                <tr>
                  <td class="text-white">
                    <%= drop.label || '(unlabeled)' %>
                    <% if (drop.has_password) { %><span class="text-xs text-yellow-400 ml-1">&#128274;</span><% } %>
                  </td>
                  <td>
                    <% if (drop.is_destroyed) { %>
                      <span class="gd-status-destroyed">Destroyed</span>
                    <% } else if (drop.expires_at && new Date(drop.expires_at) < new Date()) { %>
                      <span class="gd-status-expired">Expired</span>
                    <% } else { %>
                      <span class="gd-status-active">Active</span>
                    <% } %>
                  </td>
                  <td class="text-gray-400"><%= drop.current_views %> / <%= drop.max_views %></td>
                  <td class="text-gray-400 text-sm">
                    <% if (drop.expires_at) { %>
                      <%= new Date(drop.expires_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    <% } else { %>
                      Never
                    <% } %>
                  </td>
                  <td class="text-gray-500 text-sm">
                    <%= new Date(drop.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                  </td>
                  <td>
                    <% if (!drop.is_destroyed) { %>
                      <form method="POST" action="/dashboard/drops/<%= drop.id %>/destroy" onsubmit="return confirm('Permanently destroy this drop?')">
                        <button type="submit" class="text-red-400 hover:text-red-300 text-sm">Destroy</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</section>
