<div class="destroyed-wrap">
  <div class="destroyed-x"><span class="flame-icon-lg"></span></div>
  <div class="fire-glow" style="display:inline-block;padding:1rem 2rem;margin-top:.5rem">
    <h2 style="font-size:1.5rem">Burned</h2>
    <p style="color:var(--dim);margin-top:.75rem;font-size:.9rem;line-height:1.7">This note has been burned or never existed.</p>
  </div>
  <div><a href="/" class="btn btn-lime" style="margin-top:2rem">Send a new note</a></div>
</div>
<% if (adsenseId) { %><div class="ad-slot"><ins class="adsbygoogle" style="display:block" data-ad-client="<%= adsenseId %>" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><% } %>
