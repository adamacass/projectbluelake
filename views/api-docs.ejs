<div class="section" style="padding-top:5rem">
  <div class="section-tag">// api reference</div>
  <h1 style="font-size:2.5rem">API Documentation</h1>
  <p style="color:var(--dim);max-width:550px;margin-top:1rem;line-height:1.7">
    Integrate NoteFlame into your apps and workflows. Create and retrieve self-destructing drops programmatically.
  </p>

  <!-- Authentication -->
  <div style="margin-top:3rem">
    <h2>Authentication</h2>
    <p style="color:var(--dim);margin-top:.75rem">All API requests require a Bearer token. The token is your email and password, base64-encoded:</p>
    <pre style="background:var(--bg2);border:1px solid var(--border);padding:1.25rem;margin-top:1rem;overflow-x:auto"><code style="font-family:var(--mono);font-size:.8rem;color:var(--green);line-height:1.7"># Generate your token
echo -n "your@email.com:yourpassword" | base64

# Use in requests
curl -H "Authorization: Bearer YOUR_TOKEN" ...</code></pre>
  </div>

  <!-- Create Drop -->
  <div style="margin-top:3rem">
    <h2>Create a Drop</h2>
    <div style="margin-top:1rem;display:flex;align-items:center;gap:.75rem">
      <span style="font-family:var(--mono);font-size:.7rem;font-weight:700;background:var(--lime);color:#000;padding:.25rem .6rem;text-transform:uppercase;letter-spacing:.06em">POST</span>
      <code style="font-family:var(--mono);font-size:.85rem;color:var(--text)">/api/drops</code>
    </div>
    <h3 style="font-size:1rem;color:var(--dim);margin-top:1.5rem;font-weight:600">Request Body (JSON)</h3>
    <pre style="background:var(--bg2);border:1px solid var(--border);padding:1.25rem;margin-top:.75rem;overflow-x:auto"><code style="font-family:var(--mono);font-size:.8rem;color:var(--green);line-height:1.7">{
  "content": "my-secret-api-key-12345",
  "password": "optional-password",
  "expiry_hours": 24,
  "max_views": 1,
  "label": "API key for staging"
}</code></pre>
    <h3 style="font-size:1rem;color:var(--dim);margin-top:1.5rem;font-weight:600">Response</h3>
    <pre style="background:var(--bg2);border:1px solid var(--border);padding:1.25rem;margin-top:.75rem;overflow-x:auto"><code style="font-family:var(--mono);font-size:.8rem;color:var(--green);line-height:1.7">{
  "url": "https://noteflame.app/d/aBcDeFgHiJkLmNoPqRsTuV",
  "slug": "aBcDeFgHiJkLmNoPqRsTuV",
  "expires_at": "2025-01-16T12:00:00.000Z",
  "max_views": 1,
  "has_password": false
}</code></pre>
  </div>

  <!-- Retrieve Drop -->
  <div style="margin-top:3rem">
    <h2>Retrieve a Drop</h2>
    <div style="margin-top:1rem;display:flex;align-items:center;gap:.75rem">
      <span style="font-family:var(--mono);font-size:.7rem;font-weight:700;background:var(--green);color:#000;padding:.25rem .6rem;text-transform:uppercase;letter-spacing:.06em">GET</span>
      <code style="font-family:var(--mono);font-size:.85rem;color:var(--text)">/api/drops/:slug</code>
    </div>
    <p style="color:var(--dim);margin-top:.75rem">No authentication required. For password-protected drops, pass <code style="font-family:var(--mono);color:var(--lime)">?password=yourpassword</code>.</p>
    <pre style="background:var(--bg2);border:1px solid var(--border);padding:1.25rem;margin-top:1rem;overflow-x:auto"><code style="font-family:var(--mono);font-size:.8rem;color:var(--green);line-height:1.7">curl https://noteflame.app/api/drops/aBcDeFgHiJkLmNoPqRsTuV</code></pre>
    <h3 style="font-size:1rem;color:var(--dim);margin-top:1.5rem;font-weight:600">Response</h3>
    <pre style="background:var(--bg2);border:1px solid var(--border);padding:1.25rem;margin-top:.75rem;overflow-x:auto"><code style="font-family:var(--mono);font-size:.8rem;color:var(--green);line-height:1.7">{
  "content": "my-secret-api-key-12345",
  "destroyed": true,
  "views_remaining": 0
}</code></pre>
  </div>

  <!-- List Drops -->
  <div style="margin-top:3rem">
    <h2>List Your Drops</h2>
    <div style="margin-top:1rem;display:flex;align-items:center;gap:.75rem">
      <span style="font-family:var(--mono);font-size:.7rem;font-weight:700;background:var(--green);color:#000;padding:.25rem .6rem;text-transform:uppercase;letter-spacing:.06em">GET</span>
      <code style="font-family:var(--mono);font-size:.85rem;color:var(--text)">/api/drops</code>
    </div>
    <p style="color:var(--dim);margin-top:.75rem">Requires authentication. Returns your most recent 100 drops.</p>
  </div>

  <!-- Delete Drop -->
  <div style="margin-top:3rem">
    <h2>Delete a Drop</h2>
    <div style="margin-top:1rem;display:flex;align-items:center;gap:.75rem">
      <span style="font-family:var(--mono);font-size:.7rem;font-weight:700;background:var(--red);color:#fff;padding:.25rem .6rem;text-transform:uppercase;letter-spacing:.06em">DELETE</span>
      <code style="font-family:var(--mono);font-size:.85rem;color:var(--text)">/api/drops/:id</code>
    </div>
    <p style="color:var(--dim);margin-top:.75rem">Requires authentication. Permanently destroys the specified drop.</p>
  </div>

  <!-- Rate Limits -->
  <div style="margin-top:3rem">
    <h2>Rate Limits</h2>
    <p style="color:var(--dim);margin-top:.75rem">API requests are limited to 60 requests per minute. Response headers include rate limit info.</p>
  </div>

  <div style="margin-top:3rem;text-align:center">
    <a href="/register" class="btn btn-lime">Get API Access</a>
  </div>
</div>
