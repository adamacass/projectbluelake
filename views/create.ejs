<div class="section" style="max-width:600px;margin:0 auto">
  <div class="section-tag">// new note</div>
  <h2>Send a secret</h2>
  <p style="color:var(--dim);font-size:.85rem;margin-bottom:2rem">Encrypted, shared, then burned</p>

  <form method="POST" action="/new" id="create-form">
    <div class="fg">
      <label class="fl" for="content">Secret content</label>
      <textarea name="content" id="content" rows="8" class="ft" placeholder="Paste a password, API key, credentials..." required maxlength="500000"></textarea>
      <div style="display:flex;justify-content:space-between;margin-top:.3rem"><span class="fhint">AES-256-GCM encrypted</span><span class="fhint" id="char-count">0</span></div>
    </div>

    <div class="fr">
      <div class="fg">
        <label class="fl" for="expiry">Expires after</label>
        <select name="expiry" id="expiry" class="fs">
          <option value="1">1 hour</option>
          <option value="24" selected>24 hours</option>
          <option value="168">7 days</option>
          <option value="720">30 days</option>
        </select>
      </div>
      <div class="fg">
        <label class="fl" for="max_views">Max views</label>
        <select name="max_views" id="max_views" class="fs">
          <option value="1" selected>1 (burn after reading)</option>
          <option value="3">3 views</option>
          <option value="5">5 views</option>
          <option value="10">10 views</option>
          <option value="100">100 views</option>
        </select>
      </div>
    </div>

    <div class="fg">
      <label class="fl" for="password">Password (optional)</label>
      <input type="text" name="password" id="password" class="fi" placeholder="Adds a second factor">
    </div>

    <% if (user) { %>
    <div class="fr">
      <div class="fg">
        <label class="fl" for="label">Label (private)</label>
        <input type="text" name="label" id="label" class="fi" placeholder="e.g. staging DB creds" maxlength="255">
      </div>
      <div class="fg" style="display:flex;align-items:flex-end;padding-bottom:1.25rem">
        <label class="fcheck"><input type="checkbox" name="notify"> Notify me when viewed</label>
      </div>
    </div>
    <% } %>

    <button type="submit" class="btn btn-lime btn-full" style="margin-top:.5rem">Encrypt &amp; create link</button>
  </form>

  <% if (!user) { %><p style="text-align:center;font-size:.78rem;color:var(--muted);margin-top:1.5rem"><a href="/register">Sign up</a> to track your notes and get notified when they're read.</p><% } %>
</div>
