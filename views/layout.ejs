<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= appName %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Encrypted, self-destructing messages. Share passwords without leaving a trail.' %>">
  <link rel="canonical" href="<%= appUrl %><%= currentPath %>">
  <meta property="og:title" content="<%= title %> | NoteFlame">
  <meta property="og:description" content="Encrypted, self-destructing messages. Share passwords without leaving a trail.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= appUrl %><%= currentPath %>">
  <meta name="twitter:card" content="summary">
  <% if (currentPath === '/') { %>
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"NoteFlame","applicationCategory":"SecurityApplication","operatingSystem":"Web","description":"Encrypted, self-destructing message sharing.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}}</script>
  <% } %>
  <link rel="stylesheet" href="/css/custom.css">
  <% if (adsenseId) { %><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseId %>" crossorigin="anonymous"></script><% } %>
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">note<span>flame</span></a>
      <div class="nav-links">
        <a href="/new">🔥 new</a>
        <a href="/security" class="hm">security</a>
        <a href="/api-docs" class="hm">api</a>
        <% if (user) { %>
          <a href="/dashboard">dash<% if (notifications.length > 0) { %><span class="nav-badge"><%= notifications.length %></span><% } %></a>
          <a href="/logout">out</a>
        <% } else { %>
          <a href="/login">login</a>
          <a href="/register" class="nav-cta">sign up</a>
        <% } %>
        <% if (isAdmin) { %><a href="/ghost-admin/dashboard" style="color:#ff8c00">admin</a><% } %>
      </div>
    </div>
  </nav>

  <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

  <main><%- body %></main>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-text">note<span style="color:#baff39">flame</span></span>
      <div class="footer-links">
        <a href="/security">security</a>
        <a href="/api-docs">api</a>
      </div>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
