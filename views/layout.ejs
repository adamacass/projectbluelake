<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= appName %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Share passwords, API keys, and sensitive messages that self-destruct after being read. AES-256 encrypted. No trace left behind.' %>">
  <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' && metaKeywords ? metaKeywords : 'share password securely, self-destructing messages, encrypted message sharing, one-time secret, burn after reading, secure password sharing' %>">
  <link rel="canonical" href="<%= appUrl %><%= currentPath %>">
  <meta property="og:title" content="<%= title %> | <%= appName %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Share secrets that self-destruct. AES-256 encrypted, ephemeral, gone.' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= appUrl %><%= currentPath %>">
  <meta property="og:site_name" content="GhostDrop">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> | <%= appName %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Share secrets that self-destruct. AES-256 encrypted.' %>">
  <% if (currentPath === '/') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "GhostDrop",
    "applicationCategory": "SecurityApplication",
    "operatingSystem": "Web",
    "description": "Self-destructing encrypted message sharing. Send passwords, API keys, and secrets that vanish after being read.",
    "offers": [
      { "@type": "Offer", "price": "0", "priceCurrency": "USD", "name": "Free" },
      { "@type": "Offer", "price": "8.00", "priceCurrency": "USD", "name": "Pro", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M" } },
      { "@type": "Offer", "price": "24.00", "priceCurrency": "USD", "name": "Business", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M" } }
    ],
    "featureList": ["AES-256-GCM Encryption", "Burn After Reading", "Password Protection", "REST API", "Auto-Expiry", "Burn Notifications"]
  }
  </script>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="gd-body min-h-full flex flex-col">
  <!-- Nav -->
  <nav class="gd-nav">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <a href="/" class="flex items-center space-x-2">
          <span class="gd-logo-icon">&#9760;</span>
          <span class="text-xl font-bold text-white tracking-tight">Ghost<span class="text-purple-400">Drop</span></span>
        </a>
        <div class="flex items-center space-x-4">
          <a href="/new" class="gd-nav-link">Create Drop</a>
          <a href="/pricing" class="gd-nav-link">Pricing</a>
          <a href="/api-docs" class="gd-nav-link hidden sm:inline">API</a>
          <% if (user) { %>
            <div class="relative">
              <a href="/dashboard" class="gd-nav-link">
                Dashboard
                <% if (notifications.length > 0) { %>
                  <span class="gd-badge"><%= notifications.length %></span>
                <% } %>
              </a>
            </div>
            <a href="/logout" class="gd-nav-link text-gray-400">Log out</a>
          <% } else { %>
            <a href="/login" class="gd-nav-link">Log in</a>
            <a href="/register" class="gd-btn-sm">Sign up</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Flash messages -->
  <% if (flash) { %>
    <div class="max-w-4xl mx-auto px-4 pt-4">
      <div class="gd-flash gd-flash-<%= flash.type %>">
        <%= flash.message %>
      </div>
    </div>
  <% } %>

  <!-- Main content -->
  <main class="flex-1">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="gd-footer">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
        <div class="flex items-center space-x-2">
          <span class="gd-logo-icon text-sm">&#9760;</span>
          <span class="text-sm text-gray-400">Ghost<span class="text-purple-400">Drop</span> &mdash; Secrets that vanish.</span>
        </div>
        <div class="flex space-x-6 text-sm text-gray-500">
          <a href="/pricing" class="hover:text-gray-300">Pricing</a>
          <a href="/api-docs" class="hover:text-gray-300">API</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
