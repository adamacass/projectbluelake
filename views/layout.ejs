<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= appName %></title>
  <meta name="description" content="Share passwords, API keys, and sensitive messages that self-destruct after being read. End-to-end encrypted.">
  <meta property="og:title" content="<%= title %> | <%= appName %>">
  <meta property="og:description" content="Share secrets that self-destruct. Encrypted, ephemeral, gone.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="gd-body min-h-full flex flex-col">
  <!-- Nav -->
  <nav class="gd-nav">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <a href="/" class="flex items-center space-x-2">
          <span class="gd-logo-icon">&#9760;</span>
          <span class="text-xl font-bold text-white tracking-tight">Ghost<span class="text-purple-400">Drop</span></span>
        </a>
        <div class="flex items-center space-x-4">
          <a href="/new" class="gd-nav-link">Create Drop</a>
          <a href="/pricing" class="gd-nav-link">Pricing</a>
          <a href="/api-docs" class="gd-nav-link hidden sm:inline">API</a>
          <% if (user) { %>
            <div class="relative">
              <a href="/dashboard" class="gd-nav-link">
                Dashboard
                <% if (notifications.length > 0) { %>
                  <span class="gd-badge"><%= notifications.length %></span>
                <% } %>
              </a>
            </div>
            <a href="/logout" class="gd-nav-link text-gray-400">Log out</a>
          <% } else { %>
            <a href="/login" class="gd-nav-link">Log in</a>
            <a href="/register" class="gd-btn-sm">Sign up</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Flash messages -->
  <% if (flash) { %>
    <div class="max-w-4xl mx-auto px-4 pt-4">
      <div class="gd-flash gd-flash-<%= flash.type %>">
        <%= flash.message %>
      </div>
    </div>
  <% } %>

  <!-- Main content -->
  <main class="flex-1">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="gd-footer">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
        <div class="flex items-center space-x-2">
          <span class="gd-logo-icon text-sm">&#9760;</span>
          <span class="text-sm text-gray-400">Ghost<span class="text-purple-400">Drop</span> &mdash; Secrets that vanish.</span>
        </div>
        <div class="flex space-x-6 text-sm text-gray-500">
          <a href="/pricing" class="hover:text-gray-300">Pricing</a>
          <a href="/api-docs" class="hover:text-gray-300">API</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
