<section class="py-12">
  <div class="max-w-md mx-auto px-4 text-center">
    <div class="gd-reveal-icon">&#128274;</div>
    <h1 class="text-2xl font-bold text-white mt-4">Password Required</h1>
    <p class="text-gray-400 mt-2">This drop is password-protected. Enter the password to decrypt.</p>

    <% if (error) { %>
      <div class="gd-flash gd-flash-error mt-4"><%= error %></div>
    <% } %>

    <form method="POST" action="/d/<%= slug %>" class="mt-8">
      <input
        type="password"
        name="password"
        class="gd-input text-center text-lg"
        placeholder="Enter password"
        required
        autofocus
      >
      <button type="submit" class="gd-btn-primary w-full py-3 mt-4">
        Decrypt &amp; View
      </button>
    </form>
  </div>
</section>
