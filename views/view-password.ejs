<div class="auth-wrap" style="padding-top:4rem;text-align:center">
  <div style="font-size:2.5rem;margin-bottom:1rem">🔒</div>
  <h2 style="font-size:1.25rem">Password required</h2>
  <p style="color:var(--dim);font-size:.85rem;margin-top:.35rem">This note is locked</p>
  <% if (error) { %><div class="flash flash-error" style="margin:1rem 0"><%= error %></div><% } %>
  <form method="POST" action="/d/<%= slug %>" style="margin-top:1.5rem">
    <input type="password" name="password" class="fi" style="text-align:center" placeholder="Enter password" required autofocus>
    <button type="submit" class="btn btn-lime btn-full" style="margin-top:.75rem">Decrypt</button>
  </form>
</div>
