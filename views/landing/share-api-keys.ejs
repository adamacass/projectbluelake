  -H "Authorization: Bearer YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"content": "sk_live_abc123xyz", "expiry_hours": 1, "max_views": 1}'

# Response: {"url": "https://your-ghostdrop.com/d/aBcDeFgH..."}</code></pre>
