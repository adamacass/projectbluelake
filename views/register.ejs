<div class="auth-wrap">
  <h2 style="font-size:1.5rem">Create account</h2>
  <p style="color:var(--dim);font-size:.85rem;margin-top:.25rem">Track drops. Get notified when they're read.</p>
  <% if (error) { %><div class="flash flash-error" style="margin:1rem 0"><%= error %></div><% } %>
  <form method="POST" action="/register" style="margin-top:1.5rem">
    <div class="fg"><label class="fl" for="email">Email</label><input type="email" name="email" id="email" class="fi" required autofocus placeholder="you@example.com"></div>
    <div class="fg"><label class="fl" for="password">Password</label><input type="password" name="password" id="password" class="fi" required minlength="8" placeholder="Min 8 characters"></div>
    <div class="fg"><label class="fl" for="password_confirm">Confirm</label><input type="password" name="password_confirm" id="password_confirm" class="fi" required minlength="8"></div>
    <button type="submit" class="btn btn-lime btn-full">Create account</button>
  </form>
  <p style="text-align:center;font-size:.8rem;color:var(--muted);margin-top:1.5rem">Already have an account? <a href="/login">Log in</a></p>
</div>
