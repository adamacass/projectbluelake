<!-- How it works -->
<section class="py-20">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-white text-center">How It Works</h2>
    <p class="text-gray-400 text-center mt-2">Three steps. Zero traces.</p>

    <div class="grid md:grid-cols-3 gap-8 mt-12">
      <div class="gd-card text-center">
        <div class="gd-step-number">1</div>
        <h3 class="text-xl font-semibold text-white mt-4">Write your secret</h3>
        <p class="text-gray-400 mt-2">Paste a password, API key, private note, or any sensitive text. Optionally set a password and expiry.</p>
      </div>
      <div class="gd-card text-center">
        <div class="gd-step-number">2</div>
        <h3 class="text-xl font-semibold text-white mt-4">Share the link</h3>
        <p class="text-gray-400 mt-2">Get a unique one-time URL. Send it via chat, email, or any channel. The secret is encrypted in transit.</p>
      </div>
      <div class="gd-card text-center">
        <div class="gd-step-number">3</div>
        <h3 class="text-xl font-semibold text-white mt-4">It self-destructs</h3>
        <p class="text-gray-400 mt-2">Once read, the drop is permanently destroyed. No copies, no cache, no trace. Gone forever.</p>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
