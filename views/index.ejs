<div class="hero" style="max-width:600px">
  <div class="hero-tag">// drop a secret</div>
  <h1 style="font-size:2rem;margin-top:.75rem">Paste it. Share the link.<br><span class="accent">It self-destructs.</span></h1>

  <form method="POST" action="/new" id="create-form" style="margin-top:2rem">
    <div class="fg">
      <textarea name="content" id="content" rows="5" class="ft" placeholder="Paste a password, API key, credentials, anything sensitive..." required maxlength="500000"></textarea>
      <div style="display:flex;justify-content:space-between;margin-top:.3rem"><span class="fhint">AES-256-GCM encrypted</span><span class="fhint" id="char-count">0</span></div>
    </div>

    <div class="fr">
      <div class="fg">
        <label class="fl" for="expiry">Expires</label>
        <select name="expiry" id="expiry" class="fs">
          <option value="1">1 hour</option>
          <option value="24" selected>24 hours</option>
          <option value="168">7 days</option>
          <option value="720">30 days</option>
        </select>
      </div>
      <div class="fg">
        <label class="fl" for="max_views">Views</label>
        <select name="max_views" id="max_views" class="fs">
          <option value="1" selected>1 (burn after reading)</option>
          <option value="3">3</option>
          <option value="5">5</option>
          <option value="10">10</option>
          <option value="100">100</option>
        </select>
      </div>
    </div>

    <div class="fg">
      <label class="fl" for="password">Password (optional)</label>
      <input type="text" name="password" id="password" class="fi" placeholder="Adds a second factor">
    </div>

    <% if (user) { %>
    <div class="fr">
      <div class="fg">
        <label class="fl" for="label">Label (private)</label>
        <input type="text" name="label" id="label" class="fi" placeholder="e.g. staging DB creds" maxlength="255">
      </div>
      <div class="fg" style="display:flex;align-items:flex-end;padding-bottom:1.25rem">
        <label class="fcheck"><input type="checkbox" name="notify"> Notify on view</label>
      </div>
    </div>
    <% } %>

    <button type="submit" class="btn btn-lime btn-full">Encrypt &amp; create link</button>
  </form>

  <% if (!user) { %><p style="text-align:center;font-size:.78rem;color:var(--muted);margin-top:1.25rem"><a href="/register">Sign up</a> to track drops and get burn notifications.</p><% } %>
</div>

<% if (adsenseId) { %><div class="ad-slot"><ins class="adsbygoogle" style="display:block" data-ad-client="<%= adsenseId %>" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><% } %>

<div class="section-dark" id="how">
  <div class="section">
    <div class="section-tag">// how it works</div>
    <h2>Three steps. No traces.</h2>
    <div class="grid-3">
      <div>
        <div style="font-family:var(--mono);color:var(--lime);font-size:.7rem;margin-bottom:.5rem">01</div>
        <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:.4rem">Paste your secret</h3>
        <p style="color:var(--dim);font-size:.875rem;line-height:1.6">Password, API key, whatever. It gets AES-256-GCM encrypted before it touches any database.</p>
      </div>
      <div>
        <div style="font-family:var(--mono);color:var(--lime);font-size:.7rem;margin-bottom:.5rem">02</div>
        <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:.4rem">Share the link</h3>
        <p style="color:var(--dim);font-size:.875rem;line-height:1.6">You get a one-time URL. The secret itself never leaves our encrypted store until the moment someone opens it.</p>
      </div>
      <div>
        <div style="font-family:var(--mono);color:var(--lime);font-size:.7rem;margin-bottom:.5rem">03</div>
        <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:.4rem">It dies</h3>
        <p style="color:var(--dim);font-size:.875rem;line-height:1.6">They read it. Content is deleted. The link is dead. You get notified if you want. That's it.</p>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <div class="section-tag">// why bother</div>
  <h2>Slack search doesn't forget.</h2>
  <div style="max-width:700px">
    <div class="feat">
      <div class="feat-num">01</div>
      <div><div class="feat-title">Key-separated encryption</div><div class="feat-desc">The decryption key lives only in the URL fragment. We store a hash for lookup. A database breach exposes nothing readable.</div></div>
    </div>
    <div class="feat">
      <div class="feat-num">02</div>
      <div><div class="feat-title">Configurable burn</div><div class="feat-desc">One view and it's gone. Or set 5, 10, 10,000 views for team-wide secrets. You decide.</div></div>
    </div>
    <div class="feat">
      <div class="feat-num">03</div>
      <div><div class="feat-title">Viewer intel</div><div class="feat-desc">See when your drop was opened, what browser and OS they used. Burn notifications land on your dashboard.</div></div>
    </div>
    <div class="feat">
      <div class="feat-num">04</div>
      <div><div class="feat-title">Password lock</div><div class="feat-desc">Share the link in Slack, send the password over text. Two channels means neither one alone is useful.</div></div>
    </div>
    <div class="feat">
      <div class="feat-num">05</div>
      <div><div class="feat-title">Operation codenames</div><div class="feat-desc">Every drop gets a random codename like "Shadow Falcon" or "Ghost Protocol". Track things by name, not IDs.</div></div>
    </div>
    <div class="feat">
      <div class="feat-num">06</div>
      <div><div class="feat-title">REST API</div><div class="feat-desc">Create and retrieve drops programmatically. One curl command from your CI/CD pipeline. Docs at <a href="/api-docs">/api-docs</a>.</div></div>
    </div>
  </div>
</div>

<div class="section-dark">
  <div class="section" style="text-align:center;max-width:600px">
    <div class="section-tag">// updates</div>
    <h2>Get notified</h2>
    <p style="color:var(--dim);margin-bottom:1.5rem;font-size:.85rem">Occasional updates. No spam.</p>
    <form method="POST" action="/subscribe" style="display:flex;gap:0;border:1px solid var(--border)">
      <input type="hidden" name="source" value="landing">
      <input type="email" name="email" required placeholder="you@company.com" class="fi" style="border:none;flex:1">
      <button type="submit" class="btn btn-lime" style="white-space:nowrap">Subscribe</button>
    </form>
  </div>
</div>

<% if (adsenseId) { %><div class="ad-slot"><ins class="adsbygoogle" style="display:block" data-ad-client="<%= adsenseId %>" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><% } %>
