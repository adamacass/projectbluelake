<section class="py-12">
  <div class="max-w-2xl mx-auto px-4 text-center">
    <div class="gd-success-icon">&#10003;</div>
    <h1 class="text-3xl font-bold text-white mt-6">Drop Created</h1>
    <p class="text-gray-400 mt-2">Your secret has been encrypted and is ready to share.</p>

    <div class="gd-card mt-8">
      <label class="gd-label text-left">Share this link</label>
      <div class="flex mt-2">
        <input
          type="text"
          value="<%= dropUrl %>"
          readonly
          id="drop-url"
          class="gd-input flex-1 rounded-r-none font-mono text-sm"
        >
        <button
          onclick="copyToClipboard()"
          id="copy-btn"
          class="gd-btn-primary rounded-l-none px-6"
        >
          Copy
        </button>
      </div>

      <div class="mt-6 grid grid-cols-3 gap-4 text-sm">
        <div class="gd-stat">
          <span class="text-gray-500">Expires</span>
          <span class="text-white font-medium"><%= new Date(expiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        <div class="gd-stat">
          <span class="text-gray-500">Max Views</span>
          <span class="text-white font-medium"><%= maxViews %></span>
        </div>
        <div class="gd-stat">
          <span class="text-gray-500">Password</span>
          <span class="text-white font-medium"><%= hasPassword ? 'Yes' : 'No' %></span>
        </div>
      </div>
    </div>

    <div class="gd-warning mt-6">
      <strong>Important:</strong> Save this link now. You won't be able to see it again.
      Once the recipient opens it, the content will be permanently destroyed.
    </div>

    <div class="mt-8 flex justify-center gap-4">
      <a href="/new" class="gd-btn-secondary px-6 py-3">Create Another</a>
      <% if (user) { %>
        <a href="/dashboard" class="gd-btn-secondary px-6 py-3">Dashboard</a>
      <% } %>
    </div>
  </div>
</section>

<script>
function copyToClipboard() {
  const input = document.getElementById('drop-url');
  navigator.clipboard.writeText(input.value).then(() => {
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
}
</script>
