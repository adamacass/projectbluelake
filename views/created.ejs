<div class="created-wrap">
  <div class="codename">// Operation: <%= codename %></div>
  <h2 style="margin-top:.5rem;font-size:1.5rem">🔥 Link ready</h2>
  <p style="color:var(--dim);font-size:.85rem;margin-top:.35rem">Burns after <strong style="color:var(--text)"><%= maxViews %></strong> view<%= maxViews !== 1 ? 's' : '' %></p>

  <div class="url-box" style="margin-top:1.25rem" id="url-box">
    <input type="text" value="<%= dropUrl %>" readonly id="drop-url">
    <button onclick="copyUrl()" id="copy-btn" class="fire-glow">COPY</button>
  </div>

  <div class="meta-row">
    <div class="meta-item"><span>Expires</span><span id="countdown" data-expires="<%= expiresAt.toISOString() %>">...</span></div>
    <div class="meta-item"><span>Max views</span><span><%= maxViews %></span></div>
    <div class="meta-item"><span>Password</span><span><%= hasPassword ? 'Yes' : 'No' %></span></div>
    <div class="meta-item"><span>Codename</span><span><%= codename %></span></div>
  </div>

  <% if (qrDataUri) { %>
  <div class="qr-wrap">
    <p style="font-size:.7rem;color:var(--muted);font-family:var(--mono);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">QR Code</p>
    <img src="<%= qrDataUri %>" alt="QR Code" width="150" height="150">
  </div>
  <% } %>

  <div class="warn-box">Save this link now. You won't see it again.</div>

  <div style="margin-top:1.5rem;display:flex;gap:.75rem">
    <a href="/new" class="btn btn-outline btn-sm">Send another</a>
    <% if (user) { %><a href="/dashboard" class="btn btn-outline btn-sm">Dashboard</a><% } %>
  </div>
</div>

<% if (adsenseId) { %><div class="ad-slot"><ins class="adsbygoogle" style="display:block" data-ad-client="<%= adsenseId %>" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><% } %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var urlBox = document.getElementById('url-box');
  if (urlBox && window.triggerFireBurst) {
    window.triggerFireBurst(urlBox);
  }
});
</script>
