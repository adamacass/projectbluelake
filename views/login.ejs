<section class="py-12">
  <div class="max-w-md mx-auto px-4">
    <h1 class="text-3xl font-bold text-white text-center">Log In</h1>
    <p class="text-gray-400 text-center mt-2">Welcome back to GhostDrop.</p>

    <% if (error) { %>
      <div class="gd-flash gd-flash-error mt-4"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" class="mt-8 space-y-4">
      <div>
        <label for="email" class="gd-label">Email</label>
        <input type="email" name="email" id="email" class="gd-input" required autofocus placeholder="you@example.com">
      </div>
      <div>
        <label for="password" class="gd-label">Password</label>
        <input type="password" name="password" id="password" class="gd-input" required placeholder="Your password">
      </div>
      <button type="submit" class="gd-btn-primary w-full py-3">Log In</button>
    </form>

    <p class="text-center text-sm text-gray-400 mt-6">
      Don't have an account? <a href="/register" class="text-purple-400 hover:text-purple-300">Sign up</a>
    </p>
  </div>
</section>
