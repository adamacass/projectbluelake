<div class="auth-wrap">
  <h2 style="font-size:1.5rem">Log in</h2>
  <p style="color:var(--dim);font-size:.85rem;margin-top:.25rem">Welcome back.</p>
  <% if (error) { %><div class="flash flash-error" style="margin:1rem 0"><%= error %></div><% } %>
  <form method="POST" action="/login" style="margin-top:1.5rem">
    <div class="fg"><label class="fl" for="email">Email</label><input type="email" name="email" id="email" class="fi" required autofocus placeholder="you@example.com"></div>
    <div class="fg"><label class="fl" for="password">Password</label><input type="password" name="password" id="password" class="fi" required></div>
    <button type="submit" class="btn btn-lime btn-full">Log in</button>
  </form>
  <p style="text-align:center;font-size:.8rem;color:var(--muted);margin-top:1.5rem">No account? <a href="/register">Sign up</a></p>
</div>
